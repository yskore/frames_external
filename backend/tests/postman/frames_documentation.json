{
	"info": {
		"name": "Frames API Documentation",
		"description": "Complete API documentation for Frames application",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "User Management",
			"item": [
				{
					"name": "Create New User",
					"request": {
						"method": "POST",
						"url": "http://localhost:8080/user_basic",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"username\":\"testuser1\",\"password\":\"Test@123456\",\"email\":\"testuser1@example.com\",\"firstName\":\"Test\",\"lastName\":\"User\",\"dateOfBirth\":\"1990-01-01\",\"country\":\"United States\",\"phoneNumber\":\"+1234567890\",\"userType\":\"artist\"}"
						},
						"description": "Creates a new user account with the provided details"
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"url": "http://localhost:8080/login",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"username\":\"testuser1\",\"password\":\"Test@123456\"}"
						},
						"description": "Authenticates user and returns JWT token"
					}
				},
				{
					"name": "Check User Exists",
					"request": {
						"method": "POST",
						"url": "http://localhost:8080/user_exists",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"username\":\"testuser1\",\"email\":\"testuser1@example.com\"}"
						},
						"description": "Checks if username or email already exists"
					}
				},
				{
					"name": "Get User Info",
					"request": {
						"method": "GET",
						"url": "http://localhost:8080/user_info?username=testuser1",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwt_token}}"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"description": "Retrieves user information. JWT token optional."
					}
				},
				{
					"name": "Send OTP",
					"request": {
						"method": "POST",
						"url": "http://localhost:8080/send-otp",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"user@example.com\"}"
						},
						"description": "Sends a verification code to the specified email address. The code expires after 5 minutes."
					}
				},
				{
					"name": "Verify OTP",
					"request": {
						"method": "POST",
						"url": "http://localhost:8080/verify-otp",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "X-API-Key",
								"value": "{{api_key}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\":\"user@example.com\",\"otp\":\"123456\"}"
						},
						"description": "Verifies the OTP sent to the specified email address. The OTP must be verified within 5 minutes of being sent."
					}
				}
			]
		},
